# docker compose 용. 복사해서 .env 로 사용 (없으면 compose 의 기본값 적용)
POSTGRES_DB=rai_db
POSTGRES_USER=rai
POSTGRES_PASSWORD=rai-dev-1
POSTGRES_PORT=5434

# user-service JWT 서명키 (HS256 → 32바이트 이상). Gateway 와 같은 값을 써야 한다.
JWT_SECRET=rai-local-dev-secret-key-change-me-32bytes+
USER_SERVICE_PORT=8081
DRUG_SERVICE_PORT=8082
CHAT_SERVICE_PORT=8083

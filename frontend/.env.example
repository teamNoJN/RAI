# RAI Frontend 환경변수
#
# ── 개발 (기본: .env.development 가 실백엔드 연동으로 설정됨) ──
# VITE_USE_MOCK=false          # true 면 전부 인메모리 mock (백엔드 없이 실행)
# VITE_API_BASE_URL=           # 비우면 vite 프록시(/api → localhost:18080 게이트웨이) 사용
# VITE_PROXY_TARGET=           # vite 프록시 대상 변경 시 (기본 http://localhost:18080)
#
# ── 배포 ──
# VITE_USE_MOCK=false
# VITE_API_BASE_URL=https://<gateway-host>   # 게이트웨이 주소 (K8s/Nginx 뒤에선 비워도 됨)
